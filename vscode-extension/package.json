{
  "name": "idlistack-vscode",
  "displayName": "IdliStack",
  "description": "Zero-config deployment CLI extension directly in VS Code (Keycloak OIDC + K3s RBAC, Railway-like detection, OCI build & Helm deployment)",
  "version": "1.9.0",
  "publisher": "idlistack",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saintlionelpraveen/Idlistack-CLI"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idlistack.login",
        "title": "IdliStack: Login with Keycloak (Auth Frontend)",
        "icon": "$(shield)"
      },
      {
        "command": "idlistack.authSetup",
        "title": "IdliStack: Deploy Keycloak Auth Layer to K3s",
        "icon": "$(key)"
      },
      {
        "command": "idlistack.whoami",
        "title": "IdliStack: Check Auth & K3s RBAC Status (Whoami)",
        "icon": "$(account)"
      },
      {
        "command": "idlistack.logout",
        "title": "IdliStack: Logout from Keycloak",
        "icon": "$(sign-out)"
      },
      {
        "command": "idlistack.terminal",
        "title": "IdliStack: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "idlistack.init",
        "title": "IdliStack: Initialize Project",
        "icon": "$(file-code)"
      },
      {
        "command": "idlistack.inspect",
        "title": "IdliStack: Inspect Stack & Plan",
        "icon": "$(search)"
      },
      {
        "command": "idlistack.up",
        "title": "IdliStack: Deploy to K3s (Up)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "idlistack.status",
        "title": "IdliStack: Check Cluster Status",
        "icon": "$(server-environment)"
      },
      {
        "command": "idlistack.logs",
        "title": "IdliStack: View Logs",
        "icon": "$(terminal)"
      },
      {
        "command": "idlistack.down",
        "title": "IdliStack: Destroy (Down)",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "idlistack.login",
          "group": "idlistack@0"
        },
        {
          "command": "idlistack.inspect",
          "group": "idlistack@1"
        },
        {
          "command": "idlistack.up",
          "group": "idlistack@2"
        }
      ],
      "explorer/context": [
        {
          "command": "idlistack.login",
          "group": "idlistack@0"
        },
        {
          "command": "idlistack.inspect",
          "group": "idlistack@1"
        },
        {
          "command": "idlistack.up",
          "group": "idlistack@2"
        }
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  },
  "icon": "icon.png"
}