{
  "name": "idlistack-vscode",
  "displayName": "IdliStack",
  "description": "Zero-config deployment CLI extension directly in VS Code (Frappe Auth + Teleport K3s RBAC, Railpack detection, OCI build & Helm deployment)",
  "version": "1.14.1",
  "publisher": "idlistack",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saintlionelpraveen/Idlistack-CLI"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idlistack.login",
        "title": "IdliStack: Login via Frappe Portal",
        "icon": "$(shield)"
      },
      {
        "command": "idlistack.admin",
        "title": "IdliStack: Open Admin Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "idlistack.whoami",
        "title": "IdliStack: Check Auth & Teleport Scope (Whoami)",
        "icon": "$(account)"
      },
      {
        "command": "idlistack.logout",
        "title": "IdliStack: Logout Session",
        "icon": "$(sign-out)"
      },
      {
        "command": "idlistack.terminal",
        "title": "IdliStack: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "idlistack.init",
        "title": "IdliStack: Initialize Project",
        "icon": "$(file-code)"
      },
      {
        "command": "idlistack.inspect",
        "title": "IdliStack: Inspect Stack & Plan",
        "icon": "$(search)"
      },
      {
        "command": "idlistack.up",
        "title": "IdliStack: Deploy to K3s (Up)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "idlistack.status",
        "title": "IdliStack: Check Cluster Status",
        "icon": "$(server-environment)"
      },
      {
        "command": "idlistack.logs",
        "title": "IdliStack: View Logs",
        "icon": "$(terminal)"
      },
      {
        "command": "idlistack.down",
        "title": "IdliStack: Destroy (Down)",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "idlistack.login",
          "group": "idlistack@0"
        },
        {
          "command": "idlistack.admin",
          "group": "idlistack@1"
        },
        {
          "command": "idlistack.inspect",
          "group": "idlistack@2"
        },
        {
          "command": "idlistack.up",
          "group": "idlistack@3"
        }
      ],
      "explorer/context": [
        {
          "command": "idlistack.login",
          "group": "idlistack@0"
        },
        {
          "command": "idlistack.admin",
          "group": "idlistack@1"
        },
        {
          "command": "idlistack.inspect",
          "group": "idlistack@2"
        },
        {
          "command": "idlistack.up",
          "group": "idlistack@3"
        }
      ]
    },
    "configuration": {
      "title": "IdliStack",
      "properties": {
        "idlistack.frappeUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Default IdliStack Frappe Backend URL"
        }
      }
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  },
  "icon": "icon.png"
}